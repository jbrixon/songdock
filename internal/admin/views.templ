package admin

templ adminAuthStyles() {
	<style>
		:root {
			color-scheme: dark;
			--bg: #0b1326;
			--surface: rgba(23, 31, 51, 0.82);
			--surface-strong: #222a3d;
			--surface-border: rgba(255, 255, 255, 0.1);
			--text: #dae2fd;
			--muted: #dfbec5;
			--accent: #ffb1c6;
			--accent-2: #ecc300;
			--accent-text: #3f001c;
			--danger-bg: rgba(147, 0, 10, 0.28);
			--danger-border: rgba(255, 180, 171, 0.38);
			--danger-text: #ffdad6;
			--font-display: Sora, ui-sans-serif, system-ui, sans-serif;
			--font-body: "Hanken Grotesk", ui-sans-serif, system-ui, sans-serif;
			--font-label: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
			--radius-card: 1rem;
			--radius-control: 0.75rem;
			--radius-pill: 999px;
			--shadow-glow: 0 24px 80px rgba(0, 0, 0, 0.46), 0 0 48px rgba(255, 177, 198, 0.16);
		}
		* { box-sizing: border-box; }
		*:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: 3px;
		}
		body {
			margin: 0;
			min-height: 100dvh;
			display: grid;
			place-items: start center;
			padding: clamp(1.5rem, 5vw, 4rem) 1rem;
			font-family: var(--font-body);
			background:
				radial-gradient(circle at 20% -10%, rgba(255, 177, 198, 0.18), transparent 34rem),
				radial-gradient(circle at 85% 100%, rgba(236, 195, 0, 0.1), transparent 26rem),
				var(--bg);
			color: var(--text);
		}
		.admin-card {
			width: min(100%, 28rem);
			padding: clamp(1.75rem, 5vw, 3rem);
			border: 1px solid var(--surface-border);
			border-radius: var(--radius-card);
			background: var(--surface);
			box-shadow: var(--shadow-glow);
			backdrop-filter: blur(24px);
		}
		.admin-card__header { margin-bottom: 2.5rem; }
		.admin-logo {
			display: block;
			width: min(100%, 13rem);
			height: auto;
			margin: 0 auto 2.25rem;
		}
		.admin-eyebrow {
			margin: 0 0 0.4rem;
			color: var(--accent-2);
			font-family: var(--font-label);
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 0.18em;
			text-transform: uppercase;
		}
		h1 {
			margin: 0;
			font-family: var(--font-display);
			font-size: clamp(2rem, 8vw, 2.5rem);
			line-height: 1.05;
			letter-spacing: -0.04em;
		}
		.admin-copy { margin: 0.75rem 0 0; color: var(--muted); line-height: 1.55; }
		.admin-alert {
			margin-bottom: 1.5rem;
			padding: 1rem 1.1rem;
			border: 1px solid var(--danger-border);
			border-radius: var(--radius-control);
			background: var(--danger-bg);
			color: var(--danger-text);
		}
		.admin-form { display: grid; gap: 0.75rem; }
		.admin-form label {
			margin: 0;
		}
		.admin-form label:not(:first-child) { margin-top: 0.35rem; }
		.admin-label {
			font-family: var(--font-label);
			font-size: 0.78rem;
			font-weight: 600;
			letter-spacing: 0.05em;
			text-transform: uppercase;
		}
		.admin-input {
			width: 100%;
			min-height: 3rem;
			padding: 0.85rem 1rem;
			border: 1px solid var(--surface-border);
			border-radius: var(--radius-control);
			background: rgba(6, 14, 32, 0.88);
			color: var(--text);
			font: inherit;
		}
		.admin-input:focus {
			border-color: var(--accent);
			box-shadow: 0 0 0 4px rgba(255, 177, 198, 0.12);
		}
		.admin-button {
			margin-top: 0.65rem;
			min-height: 3rem;
			width: 100%;
			padding: 0.95rem 1rem;
			border: 0;
			border-radius: var(--radius-pill);
			background: linear-gradient(135deg, var(--accent), var(--accent-2));
			color: var(--accent-text);
			font: inherit;
			font-weight: 800;
			cursor: pointer;
			box-shadow: 0 0 28px rgba(255, 177, 198, 0.25);
			transition: transform 160ms ease, box-shadow 160ms ease;
		}
		.admin-button:hover {
			transform: translateY(-1px);
			box-shadow: 0 0 42px rgba(255, 177, 198, 0.38);
		}
		.admin-inline-link { color: var(--accent); }
		.admin-auth-footer { margin-top: 1.25rem; text-align: center; }
		@media (prefers-reduced-motion: reduce) {
			.admin-button { transition: none; }
			.admin-button:hover { transform: none; box-shadow: none; }
		}
	</style>
}

templ adminBaseStyles() {
	<style>
		:root {
			color-scheme: dark;
			--bg: #0b1326;
			--surface: rgba(23, 31, 51, 0.84);
			--surface-low: #131b2e;
			--surface-high: #222a3d;
			--surface-border: rgba(255, 255, 255, 0.1);
			--text: #dae2fd;
			--muted: #dfbec5;
			--accent: #ffb1c6;
			--accent-2: #ecc300;
			--accent-text: #3f001c;
			--danger-bg: rgba(147, 0, 10, 0.28);
			--danger-border: rgba(255, 180, 171, 0.38);
			--danger-text: #ffdad6;
			--font-display: Sora, ui-sans-serif, system-ui, sans-serif;
			--font-body: "Hanken Grotesk", ui-sans-serif, system-ui, sans-serif;
			--font-label: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
			--radius-card: 1rem;
			--radius-control: 0.75rem;
			--radius-pill: 999px;
		}
		* { box-sizing: border-box; }
		*:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: 3px;
		}
		body {
			margin: 0;
			min-height: 100dvh;
			display: grid;
			place-items: start center;
			padding: clamp(1.5rem, 5vw, 4rem) 1rem;
			font-family: var(--font-body);
			background:
				radial-gradient(circle at 15% -8%, rgba(255, 177, 198, 0.15), transparent 34rem),
				radial-gradient(circle at 100% 90%, rgba(236, 195, 0, 0.08), transparent 28rem),
				var(--bg);
			color: var(--text);
		}
		main {
			width: min(100%, 64rem);
			position: relative;
			padding: clamp(1.5rem, 4vw, 2.75rem);
			border: 1px solid var(--surface-border);
			border-radius: var(--radius-card);
			background: var(--surface);
			box-shadow: 0 24px 80px rgba(0, 0, 0, 0.42);
			backdrop-filter: blur(18px);
		}
		section { margin-top: 3.5rem; overflow-x: auto; }
		.admin-form { display: grid; gap: 0.75rem; }
		.admin-form label:not(:first-child) { margin-top: 0.35rem; }
		.admin-section-header {
			display: flex;
			align-items: start;
			justify-content: space-between;
			gap: 1rem;
			margin-bottom: 1.5rem;
		}
		.admin-section-header h2 { margin-bottom: 0; }
		.admin-section-header > div { min-width: 0; }
		.admin-meta { margin: 0.75rem 0 0; line-height: 1.55; }
		.admin-logout-form { flex: 0 0 auto; margin-top: 0.25rem; }
		.admin-logout-button {
			margin-top: 0;
			border: 1px solid var(--surface-border);
			background: rgba(23, 31, 51, 0.72);
			color: var(--text);
			box-shadow: none;
		}
		.admin-page-logo {
			display: block;
			width: 8rem;
			height: auto;
			margin-bottom: 1.5rem;
		}
		h1,
		h2 {
			font-family: var(--font-display);
			line-height: 1.2;
		}
		h1 { margin: 0; font-size: clamp(2rem, 7vw, 2.75rem); line-height: 1.05; letter-spacing: -0.04em; }
		h2 { margin: 0 0 0.75rem; font-size: 1.5rem; letter-spacing: -0.02em; }
		p { color: var(--muted); line-height: 1.55; }
		label {
			display: block;
			margin-bottom: 0;
			font-family: var(--font-label);
			font-size: 0.78rem;
			font-weight: 600;
			letter-spacing: 0.05em;
			text-transform: uppercase;
		}
		select {
			width: 100%;
			min-height: 3rem;
			padding: 0.85rem 0.95rem;
			border: 1px solid var(--surface-border);
			border-radius: var(--radius-control);
			background: #060e20;
			color: var(--text);
			font: inherit;
		}
		select.admin-disabled-control {
			border-color: rgba(223, 190, 197, 0.32);
			background: repeating-linear-gradient(135deg, #1a2235, #1a2235 0.45rem, #222a3d 0.45rem, #222a3d 0.9rem);
			color: #aab2c4;
			cursor: not-allowed;
			box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
			opacity: 1;
		}
		select:focus,
		input:focus,
		textarea:focus {
			border-color: var(--accent);
			box-shadow: 0 0 0 4px rgba(255, 177, 198, 0.12);
		}
		button {
			min-height: 3rem;
			margin-top: 0.8rem;
			padding: 0.85rem 1.1rem;
			border: 0;
			border-radius: var(--radius-pill);
			background: linear-gradient(135deg, var(--accent), var(--accent-2));
			color: var(--accent-text);
			font: inherit;
			font-weight: 800;
			cursor: pointer;
			box-shadow: 0 0 24px rgba(255, 177, 198, 0.22);
			transition: transform 160ms ease, box-shadow 160ms ease;
		}
		button:hover { transform: translateY(-1px); box-shadow: 0 0 36px rgba(255, 177, 198, 0.3); }
		button:active { transform: translateY(0); }
		button.admin-disabled-control {
			border: 1px solid rgba(223, 190, 197, 0.32);
			background: #222a3d;
			color: #aab2c4;
			cursor: not-allowed;
			box-shadow: none;
			opacity: 1;
		}
		button.admin-disabled-control:hover {
			box-shadow: none;
			transform: none;
		}
		.admin-link-button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 0.85rem 1.1rem;
			min-height: 2.875rem;
			border-radius: var(--radius-pill);
			background: linear-gradient(135deg, var(--accent), var(--accent-2));
			color: var(--accent-text);
			font-weight: 800;
			text-decoration: none;
			box-shadow: 0 0 24px rgba(255, 177, 198, 0.22);
		}
		.admin-link-button--secondary {
			border: 1px solid var(--surface-border);
			background: rgba(23, 31, 51, 0.72);
			color: var(--text);
			box-shadow: none;
		}
		.admin-link-button--disabled {
			opacity: 0.45;
			cursor: not-allowed;
		}
		.admin-create-song {
			display: flex;
			justify-content: flex-end;
			margin: 1.5rem 0 0;
		}
		table {
			width: 100%;
			border-collapse: collapse;
			table-layout: fixed;
		}
		th,
		td {
			padding: 1rem 0.85rem;
			border-top: 1px solid var(--surface-border);
			text-align: left;
			vertical-align: top;
			overflow-wrap: anywhere;
		}
		th {
			color: var(--muted);
			font-family: var(--font-label);
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 0.05em;
			text-transform: uppercase;
		}
		th:nth-child(3),
		td:nth-child(3) {
			width: 6rem;
		}
		a { color: var(--accent); }
		.admin-alert {
			padding: 0.9rem 1rem;
			border: 1px solid var(--danger-border);
			border-radius: var(--radius-control);
			background: var(--danger-bg);
			color: var(--danger-text);
		}
		.admin-alert--success {
			border-color: rgba(70, 194, 169, 0.36);
			background: rgba(70, 194, 169, 0.12);
			color: #c8fff3;
		}
		input,
		textarea {
			width: 100%;
			min-height: 3rem;
			padding: 0.85rem 0.95rem;
			border: 1px solid var(--surface-border);
			border-radius: var(--radius-control);
			background: #060e20;
			color: var(--text);
			font: inherit;
		}
		textarea { min-height: 7rem; resize: vertical; }
		.admin-form-page { max-width: 36rem; }
		.admin-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			align-items: center;
			margin-top: 0.5rem;
		}
		.admin-actions button { margin-top: 0; }
		.admin-danger-button {
			border: 1px solid var(--danger-border);
			background: var(--danger-bg);
			color: var(--danger-text);
			box-shadow: none;
		}
		.admin-danger-menu {
			margin-top: 3rem;
			padding-top: 1.5rem;
			border-top: 1px solid var(--surface-border);
		}
		.admin-danger-menu summary {
			color: var(--muted);
			cursor: pointer;
			font-family: var(--font-label);
			font-size: 0.78rem;
			font-weight: 600;
			letter-spacing: 0.05em;
			text-transform: uppercase;
		}
		.admin-danger-menu form { margin-top: 1rem; }
		.admin-danger-menu button { margin-top: 0; }
		@media (max-width: 640px) {
			body { display: block; padding: 0; }
			main {
				width: 100% !important;
				padding: 1.25rem;
				border-radius: 0;
				border-left: 0;
				border-right: 0;
			}
			.admin-section-header { display: block; }
			.admin-section-header .admin-link-button { margin-top: 0.75rem; width: 100%; }
			.admin-logout-form { margin-top: 1.25rem; }
			.admin-logout-button { width: 100%; }
			table { min-width: 36rem; }
		}
		@media (prefers-reduced-motion: reduce) {
			button { transition: none; }
			button:hover { transform: none; box-shadow: none; }
		}
	</style>
}

templ htmxScript() {
	<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.4/dist/htmx.min.js" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous"></script>
}

templ LoginCard(view loginView) {
	<section id="login-card" class="admin-card" aria-labelledby="admin-login-title">
		<div class="admin-card__header">
			<img class="admin-logo" src="/static/songdock_logo_dark.v2.png" alt="SongDock"/>
			<p class="admin-eyebrow">Admin</p>
			<h1 id="admin-login-title">Log in</h1>
			<p class="admin-copy">Sign in to access admin pages.</p>
		</div>
		if view.Error != "" {
			<div class="admin-alert" role="alert">{ view.Error }</div>
		}
		<form
			class="admin-form"
			method="post"
			action="/admin/login"
			hx-post="/admin/login"
			hx-target="#login-card"
			hx-swap="outerHTML"
		>
			<label class="admin-label" for="email">Email</label>
			<input class="admin-input" id="email" name="email" type="email" autocomplete="email" required value={ view.Email }/>
			<label class="admin-label" for="password">Password</label>
			<input class="admin-input" id="password" name="password" type="password" autocomplete="current-password" required/>
			<button class="admin-button" type="submit">Log in</button>
		</form>
		<p class="admin-copy admin-auth-footer">
			New here? <a class="admin-inline-link" href="/admin/register">Create your account</a>
		</p>
	</section>
}

templ LoginPage(view loginView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="icon" href="/static/favicon/favicon.ico"/>
			<title>Admin Login</title>
			@htmxScript()
			@adminAuthStyles()
		</head>
		<body>
			@LoginCard(view)
		</body>
	</html>
}

templ RegisterCard(view registerView) {
	<section id="register-card" class="admin-card" aria-labelledby="admin-register-title">
		<div class="admin-card__header">
			<img class="admin-logo" src="/static/songdock_logo_dark.v2.png" alt="SongDock"/>
			<p class="admin-eyebrow">Admin</p>
			<h1 id="admin-register-title">Create account</h1>
			<p class="admin-copy">Enter the invite code you received and choose a password.</p>
		</div>
		if view.Error != "" {
			<div class="admin-alert" role="alert">{ view.Error }</div>
		}
		<form
			class="admin-form"
			method="post"
			action="/admin/register"
			hx-post="/admin/register"
			hx-target="#register-card"
			hx-swap="outerHTML"
		>
			<label class="admin-label" for="invite_code">Invite code</label>
			<input class="admin-input" id="invite_code" name="invite_code" type="text" autocomplete="off" required value={ view.InviteCode }/>
			<label class="admin-label" for="password">Password</label>
			<input class="admin-input" id="password" name="password" type="password" autocomplete="new-password" minlength="12" required/>
			<label class="admin-label" for="password_confirm">Confirm password</label>
			<input class="admin-input" id="password_confirm" name="password_confirm" type="password" autocomplete="new-password" minlength="12" required/>
			<button class="admin-button" type="submit">Create account</button>
		</form>
		<p class="admin-copy admin-auth-footer">
			Already have an account? <a class="admin-inline-link" href="/admin/login">Log in</a>
		</p>
	</section>
}

templ RegisterPage(view registerView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="icon" href="/static/favicon/favicon.ico"/>
			<title>Create Account</title>
			@htmxScript()
			@adminAuthStyles()
		</head>
		<body>
			@RegisterCard(view)
		</body>
	</html>
}

templ HomePage(view homeView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="icon" href="/static/favicon/favicon.ico"/>
			<title>Admin</title>
			@htmxScript()
			@adminBaseStyles()
			<style>
				main.admin-home { width: min(100%, 72.5rem); padding: 0; border: 0; background: transparent; box-shadow: none; backdrop-filter: none; }
				.admin-home-header { display: grid; grid-template-columns: 1fr auto; align-items: start; gap: 2rem; margin-bottom: 3rem; }
				.admin-home-header h1 { font-size: clamp(2.5rem, 5vw, 3.5rem); }
				.admin-home-header .admin-meta { display: flex; align-items: center; gap: 0.65rem; margin: 0; font-size: 1.1rem; }
				.admin-home-header__meta-row { display: flex; align-items: center; gap: 1rem; }
				.admin-home-header .admin-page-logo { display: none; }
				.admin-home-header__actions { display: flex; align-items: center; gap: 0.75rem; }
				.admin-icon { width: 1.25rem; height: 1.25rem; display: block; flex: 0 0 auto; }
				.admin-icon--section { width: 1.35rem; height: 1.35rem; }
				.admin-icon--button { width: 1.1rem; height: 1.1rem; }
				.artist-picker { display: flex; align-items: center; gap: 1rem; min-width: 23rem; padding: 0.75rem 1rem; border-radius: var(--radius-card); background: var(--surface-high); }
				.artist-picker__details { flex: 1; min-width: 0; }
				.artist-picker__label { display: block; margin: 0 0 0.35rem; color: var(--muted); font-size: 0.75rem; }
				.artist-picker__name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 1.3rem; font-weight: 700; text-transform: none; letter-spacing: 0; }
				.artist-picker select { min-height: 0; padding: 0; border: 0; background: transparent; font-size: 1.3rem; font-weight: 700; }
				.artist-picker__logout { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; min-height: 2.75rem; margin: 0; padding: 0; border-radius: 50%; background: transparent; color: var(--muted); box-shadow: none; line-height: 0; transition: background 160ms ease, color 160ms ease; }
				.artist-picker__logout:hover { transform: none; background: var(--surface-high); color: var(--text); box-shadow: none; }
				.artist-picker__logout:active { transform: none; background: var(--accent); color: var(--accent-text); box-shadow: none; }
				.admin-home-alerts { display: grid; gap: 0.75rem; margin-bottom: 1.5rem; }
				.admin-home-grid { display: grid; grid-template-columns: minmax(18rem, 0.9fr) minmax(0, 2fr); gap: 1.5rem; align-items: stretch; }
				.admin-home-panel { padding: 2.5rem; border-radius: var(--radius-card); background: var(--surface); box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28); }
				.admin-home-panel h2 { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 2.5rem; font-size: 1.8rem; }
				.admin-home-panel h2::before { content: none; }
				.admin-home-panel h2 .admin-icon-wrap { display: grid; place-items: center; width: 3rem; height: 3rem; flex: 0 0 3rem; border-radius: 50%; background: var(--surface-low); box-shadow: inset 0 0 0 1px var(--surface-border); }
				.admin-home-panel--tracking { display: flex; flex-direction: column; }
				.admin-home-panel--tracking .admin-form { flex: 1; }
				.admin-home-panel--tracking input { min-height: 4.4rem; margin-top: 0.5rem; font-size: 1.1rem; }
				.admin-home-panel--tracking .admin-meta { max-width: 19rem; margin: 1.25rem 0 2rem; }
				.admin-home-panel--tracking button { width: 100%; margin-top: auto; border: 1px solid var(--accent); background: transparent; color: var(--text); box-shadow: none; }
				.admin-home-panel--tracking button { display: inline-flex; align-items: center; justify-content: center; gap: 0.65rem; }
				.admin-home-panel--tracking button:hover { box-shadow: 0 0 24px rgba(255, 177, 198, 0.18); }
				.admin-home-panel--songs { min-width: 0; }
				.admin-home-panel--songs .admin-section-header { align-items: center; margin-bottom: 2rem; }
				.admin-home-panel--songs .admin-section-header h2 { margin: 0; }
				.admin-home-panel--songs .admin-link-button { gap: 4px; }
				.admin-home-panel--songs table { table-layout: auto; }
				.admin-home-panel--songs th, .admin-home-panel--songs td { padding: 1.1rem 0.65rem; vertical-align: middle; }
				.admin-home-panel--songs th:first-child, .admin-home-panel--songs td:first-child { width: 48%; }
				.admin-home-panel--songs th:nth-child(2), .admin-home-panel--songs td:nth-child(2) { width: 36%; }
				.admin-home-panel--songs th:last-child, .admin-home-panel--songs td:last-child { width: 16%; text-align: right; }
				.song-title-cell { display: flex; align-items: center; gap: 1rem; font-size: 1.2rem; }
				.song-artwork { width: 3.75rem; height: 3.75rem; flex: 0 0 3.75rem; border-radius: 0.65rem; object-fit: cover; background: var(--surface-low); }
				.song-url-cell { display: flex; align-items: center; gap: 0.75rem; }
				.song-url { color: var(--muted); font-size: 0.95rem; text-decoration: none; }
				.song-actions { display: flex; justify-content: flex-end; gap: 1.25rem; }
				.song-actions a { display: inline-flex; color: var(--muted); }
				.song-actions a:hover { color: var(--text); }
				.admin-home .admin-create-song { margin: 0; }
				.admin-home-footer { margin-top: 4.5rem; padding-top: 1rem; text-align: center; }
				.admin-home-footer .admin-page-logo { width: 7rem; margin: 0 auto; opacity: 0.82; }
				@media (max-width: 760px) {
					.admin-home-header { grid-template-columns: 1fr; margin-bottom: 2rem; }
					.artist-picker { min-width: 0; width: 100%; }
					.admin-home-grid { grid-template-columns: 1fr; }
				}
			</style>
		</head>
		<body>
			<main class="admin-home">
				<header class="admin-home-header">
					<div>
						<img class="admin-page-logo" src="/static/songdock_logo_dark.v2.png" alt="SongDock"/>
						<h1>Welcome, Admin</h1>
						<div class="admin-home-header__meta-row">
							<p class="admin-meta"><svg class="admin-icon" aria-hidden="true"><use href="/static/lucide.svg#mail"></use></svg>{ view.Email }</p>
							<form class="admin-logout-form" method="post" action="/admin/logout">
								<button class="artist-picker__logout" type="submit" aria-label="Log out"><svg class="admin-icon" aria-hidden="true"><use href="/static/lucide.svg#log-out"></use></svg></button>
							</form>
						</div>
					</div>
				if len(view.Artists) > 0 {
					<div class="admin-home-header__actions">
					<form class="artist-picker" method="post" action="/admin/active-artist" hx-post="/admin/active-artist" hx-trigger="change from:#artist_slug" hx-swap="none">
						<div class="artist-picker__details">
							<label class="artist-picker__label" for="artist_slug">Active artist</label>
							<select id="artist_slug" name="artist_slug" required disabled>
								for _, artist := range view.Artists {
									if view.ActiveArtist != nil && view.ActiveArtist.Slug == artist.Slug {
										<option value={ artist.Slug } selected>{ artist.Name }</option>
									} else {
										<option value={ artist.Slug }>{ artist.Name }</option>
									}
								}
							</select>
						</div>
					</form>
					</div>
				}
				</header>
				if view.Error != "" {
					<p class="admin-alert" role="alert">{ view.Error }</p>
				}
				if view.Message != "" {
					<p class="admin-alert admin-alert--success" role="status">{ view.Message }</p>
				}
				if view.ActiveArtist != nil {
					<div class="admin-home-grid">
					<section class="admin-home-panel admin-home-panel--tracking" aria-labelledby="artist-settings-title">
						<h2 id="artist-settings-title"><span class="admin-icon-wrap"><svg class="admin-icon admin-icon--section" aria-hidden="true"><use href="/static/lucide.svg#crosshair"></use></svg></span>Tracking</h2>
						<form class="admin-form" method="post" action="/admin/artist-settings">
							<label for="meta_pixel_id">Meta Pixel ID</label>
							<input id="meta_pixel_id" name="meta_pixel_id" inputmode="numeric" pattern="[0-9]*" value={ view.ActiveArtist.MetaPixelID } aria-describedby="meta-pixel-help"/>
							<p id="meta-pixel-help" class="admin-meta">Track conversions and build custom audiences across the Meta ecosystem for this artist's landing pages.</p>
							<button type="submit">Save Settings <svg class="admin-icon" aria-hidden="true"><use href="/static/lucide.svg#arrow-right"></use></svg></button>
						</form>
					</section>
					<section class="admin-home-panel admin-home-panel--songs" aria-labelledby="songs-title">
						<div class="admin-section-header">
							<h2 id="songs-title"><span class="admin-icon-wrap"><svg class="admin-icon admin-icon--section" aria-hidden="true"><use href="/static/lucide.svg#list-music"></use></svg></span>Discography</h2>
							<p class="admin-create-song"><a class="admin-link-button" href="/admin/songs/new"><svg class="admin-icon admin-icon--button" aria-hidden="true"><use href="/static/lucide.svg#plus"></use></svg>New Song</a></p>
						</div>
						<table>
							<thead>
								<tr>
									<th scope="col">Title</th>
									<th scope="col">Final URL</th>
									<th scope="col">Actions</th>
								</tr>
							</thead>
							<tbody>
								if len(view.Songs) > 0 {
										for _, song := range view.Songs {
										<tr>
											<td><div class="song-title-cell"><img class="song-artwork" src={ song.ArtworkURL } alt=""/>{ song.Title }</div></td>
											<td><div class="song-url-cell"><a class="song-url" href={ song.FinalURL } target="_blank" rel="noopener noreferrer">{ song.FinalURL }</a><a href={ song.FinalURL } target="_blank" rel="noopener noreferrer" aria-label={ "Open " + song.Title + " in a new tab" }><svg class="admin-icon" aria-hidden="true"><use href="/static/lucide.svg#external-link"></use></svg></a></div></td>
											<td><div class="song-actions"><a href={ song.EditURL } aria-label={ "Edit " + song.Title }><svg class="admin-icon" aria-hidden="true"><use href="/static/lucide.svg#pencil"></use></svg></a></div></td>
										</tr>
									}
								} else {
									<tr>
										<td colspan="3">No songs yet.</td>
									</tr>
								}
							</tbody>
						</table>
					</section>
					</div>
				} else {
					<p>No artists are assigned to your account.</p>
					<p class="admin-create-song"><span class="admin-link-button admin-link-button--disabled" aria-disabled="true">Create a new song</span></p>
				}
				<footer class="admin-home-footer">
					<img class="admin-page-logo" src="/static/songdock_logo_dark.v2.png" alt="SongDock"/>
				</footer>
			</main>
		</body>
	</html>
}

templ SongFormPage(view songFormView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="icon" href="/static/favicon/favicon.ico"/>
			<title>{ view.PageTitle }</title>
			@htmxScript()
			@adminBaseStyles()
		</head>
		<body>
			<main class="admin-form-page">
				<header class="admin-section-header">
					<div>
						<img class="admin-page-logo" src="/static/songdock_logo_dark.v2.png" alt="SongDock"/>
						<h1>{ view.PageTitle }</h1>
					</div>
				</header>
				if view.Error != "" {
					<p class="admin-alert" role="alert">{ view.Error }</p>
				}
				if view.ActiveArtist != nil {
					<p class="admin-meta">Artist: { view.ActiveArtist.Name }</p>
					<form class="admin-form" method="post" enctype="multipart/form-data" action={ view.Action }>
						<label for="title">Title</label>
						<input id="title" name="title" required value={ view.Title }/>
						<label for="description">Description</label>
						<textarea id="description" name="description">{ view.Description }</textarea>
						<label for="artwork">Cover artwork</label>
						<div class="artwork-preview"><img id="artwork-preview" src={ view.ArtworkURL } alt="Artwork preview"/></div>
						<input id="artwork" name="artwork" type="file" accept="image/jpeg,image/png,image/webp"/>
						<label for="youtube_url">YouTube URL</label>
						<input id="youtube_url" name="youtube_url" value={ view.YouTubeURL }/>
						<label for="spotify_url">Spotify URL</label>
						<input id="spotify_url" name="spotify_url" value={ view.SpotifyURL }/>
						<label for="apple_music_url">Apple Music URL</label>
						<input id="apple_music_url" name="apple_music_url" value={ view.AppleMusicURL }/>
						<div class="admin-actions">
							<button type="submit">{ view.SubmitLabel }</button>
							<a class="admin-link-button admin-link-button--secondary" href="/admin/">Cancel</a>
						</div>
					</form>
					<script>
						const artworkInput = document.getElementById("artwork");
						const artworkPreview = document.getElementById("artwork-preview");
						artworkInput?.addEventListener("change", () => {
							const file = artworkInput.files?.[0];
							if (!file) return;
							const reader = new FileReader();
							reader.addEventListener("load", () => artworkPreview.src = reader.result);
							reader.readAsDataURL(file);
						});
					</script>
					if view.Mode == "edit" {
						<details class="admin-danger-menu">
							<summary>More options</summary>
							if view.ArtworkPath != "" {
								<form method="post" action={ view.RemoveArtworkAction } hx-post={ view.RemoveArtworkAction } hx-confirm="Remove this artwork?" hx-swap="none">
									<button type="submit">Remove Artwork</button>
								</form>
							}
							<form method="post" action={ view.DeleteAction } hx-post={ view.DeleteAction } hx-confirm="Delete this song? This cannot be undone." hx-swap="none">
								<button class="admin-danger-button" type="submit">Delete Song</button>
							</form>
						</details>
					}
				} else {
					<p><a class="admin-link-button" href="/admin/">Back to dashboard</a></p>
				}
			</main>
		</body>
	</html>
}
