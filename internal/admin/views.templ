package admin

templ adminAuthStyles() {
	<style>
		:root {
			color-scheme: dark;
			--bg: #0b1326;
			--surface: rgba(23, 31, 51, 0.82);
			--surface-strong: #222a3d;
			--surface-border: rgba(255, 255, 255, 0.1);
			--text: #dae2fd;
			--muted: #dfbec5;
			--accent: #ffb1c6;
			--accent-2: #ecc300;
			--accent-text: #3f001c;
			--danger-bg: rgba(147, 0, 10, 0.28);
			--danger-border: rgba(255, 180, 171, 0.38);
			--danger-text: #ffdad6;
			--font-display: Sora, ui-sans-serif, system-ui, sans-serif;
			--font-body: "Hanken Grotesk", Inter, ui-sans-serif, system-ui, sans-serif;
			--font-label: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
			--radius-card: 1rem;
			--radius-control: 0.75rem;
			--radius-pill: 999px;
			--shadow-glow: 0 24px 80px rgba(0, 0, 0, 0.46), 0 0 48px rgba(255, 177, 198, 0.16);
		}
		* { box-sizing: border-box; }
		*:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: 3px;
		}
		body {
			margin: 0;
			min-height: 100vh;
			display: grid;
			place-items: center;
			padding: 1.5rem;
			font-family: var(--font-body);
			background:
				radial-gradient(circle at 20% -10%, rgba(255, 177, 198, 0.18), transparent 34rem),
				radial-gradient(circle at 85% 100%, rgba(236, 195, 0, 0.1), transparent 26rem),
				var(--bg);
			color: var(--text);
		}
		.admin-card {
			width: min(100%, 28rem);
			padding: 2rem;
			border: 1px solid var(--surface-border);
			border-radius: var(--radius-card);
			background: var(--surface);
			box-shadow: var(--shadow-glow);
			backdrop-filter: blur(24px);
		}
		.admin-card__header { margin-bottom: 1.5rem; }
		.admin-logo {
			display: block;
			width: min(100%, 17rem);
			height: auto;
			margin: 0 auto 1.75rem;
		}
		.admin-eyebrow {
			margin: 0 0 0.4rem;
			color: var(--accent-2);
			font-family: var(--font-label);
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 0.18em;
			text-transform: uppercase;
		}
		h1 {
			margin: 0;
			font-family: var(--font-display);
			font-size: clamp(2rem, 8vw, 2.5rem);
			line-height: 1.15;
		}
		.admin-copy { margin: 0.5rem 0 0; color: var(--muted); }
		.admin-alert {
			margin-bottom: 1rem;
			padding: 0.9rem 1rem;
			border: 1px solid var(--danger-border);
			border-radius: var(--radius-control);
			background: var(--danger-bg);
			color: var(--danger-text);
		}
		.admin-form { display: grid; gap: 0.85rem; }
		.admin-label {
			font-family: var(--font-label);
			font-size: 0.78rem;
			font-weight: 600;
			letter-spacing: 0.05em;
			text-transform: uppercase;
		}
		.admin-input {
			width: 100%;
			padding: 0.9rem 1rem;
			border: 1px solid var(--surface-border);
			border-radius: var(--radius-control);
			background: rgba(6, 14, 32, 0.88);
			color: var(--text);
			font: inherit;
		}
		.admin-input:focus {
			border-color: var(--accent);
			box-shadow: 0 0 0 4px rgba(255, 177, 198, 0.12);
		}
		.admin-button {
			margin-top: 0.5rem;
			padding: 0.95rem 1rem;
			border: 0;
			border-radius: var(--radius-pill);
			background: linear-gradient(135deg, var(--accent), var(--accent-2));
			color: var(--accent-text);
			font: inherit;
			font-weight: 800;
			cursor: pointer;
			box-shadow: 0 0 28px rgba(255, 177, 198, 0.25);
			transition: transform 160ms ease, box-shadow 160ms ease;
		}
		.admin-button:hover {
			transform: translateY(-1px);
			box-shadow: 0 0 42px rgba(255, 177, 198, 0.38);
		}
	</style>
}

templ adminBaseStyles() {
	<style>
		:root {
			color-scheme: dark;
			--bg: #0b1326;
			--surface: rgba(23, 31, 51, 0.84);
			--surface-low: #131b2e;
			--surface-high: #222a3d;
			--surface-border: rgba(255, 255, 255, 0.1);
			--text: #dae2fd;
			--muted: #dfbec5;
			--accent: #ffb1c6;
			--accent-2: #ecc300;
			--accent-text: #3f001c;
			--danger-bg: rgba(147, 0, 10, 0.28);
			--danger-border: rgba(255, 180, 171, 0.38);
			--danger-text: #ffdad6;
			--font-display: Sora, ui-sans-serif, system-ui, sans-serif;
			--font-body: "Hanken Grotesk", Inter, ui-sans-serif, system-ui, sans-serif;
			--font-label: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
			--radius-card: 1rem;
			--radius-control: 0.75rem;
			--radius-pill: 999px;
		}
		* { box-sizing: border-box; }
		*:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: 3px;
		}
		body {
			margin: 0;
			min-height: 100vh;
			display: grid;
			place-items: center;
			padding: 1.5rem;
			font-family: var(--font-body);
			background:
				radial-gradient(circle at 15% -8%, rgba(255, 177, 198, 0.15), transparent 34rem),
				radial-gradient(circle at 100% 90%, rgba(236, 195, 0, 0.08), transparent 28rem),
				var(--bg);
			color: var(--text);
		}
		main {
			width: min(100%, 48rem);
			position: relative;
			padding: 2rem;
			border: 1px solid var(--surface-border);
			border-radius: var(--radius-card);
			background: var(--surface);
			box-shadow: 0 24px 80px rgba(0, 0, 0, 0.42);
			backdrop-filter: blur(18px);
		}
		section { margin-top: 1.5rem; overflow-x: auto; }
		.admin-logout-form {
			position: absolute;
			top: 2rem;
			right: 2rem;
		}
		.admin-logout-button { margin-top: 0; }
		.admin-page-logo {
			display: block;
			width: 8rem;
			height: auto;
			margin-bottom: 1rem;
		}
		h1,
		h2 {
			font-family: var(--font-display);
			line-height: 1.2;
		}
		h1 { margin: 0; font-size: clamp(2rem, 7vw, 2.5rem); }
		h2 { margin: 0 0 0.75rem; font-size: 1.5rem; }
		p { color: var(--muted); }
		label {
			display: block;
			margin-bottom: 0.5rem;
			font-family: var(--font-label);
			font-size: 0.78rem;
			font-weight: 600;
			letter-spacing: 0.05em;
			text-transform: uppercase;
		}
		select {
			width: 100%;
			padding: 0.85rem 0.95rem;
			border: 1px solid var(--surface-border);
			border-radius: var(--radius-control);
			background: #060e20;
			color: var(--text);
			font: inherit;
		}
		select.admin-disabled-control {
			border-color: rgba(223, 190, 197, 0.32);
			background: repeating-linear-gradient(135deg, #1a2235, #1a2235 0.45rem, #222a3d 0.45rem, #222a3d 0.9rem);
			color: #aab2c4;
			cursor: not-allowed;
			box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
			opacity: 1;
		}
		select:focus,
		input:focus,
		textarea:focus {
			border-color: var(--accent);
			box-shadow: 0 0 0 4px rgba(255, 177, 198, 0.12);
		}
		button {
			margin-top: 0.8rem;
			padding: 0.85rem 1.1rem;
			border: 0;
			border-radius: var(--radius-pill);
			background: linear-gradient(135deg, var(--accent), var(--accent-2));
			color: var(--accent-text);
			font: inherit;
			font-weight: 800;
			cursor: pointer;
			box-shadow: 0 0 24px rgba(255, 177, 198, 0.22);
		}
		button.admin-disabled-control {
			border: 1px solid rgba(223, 190, 197, 0.32);
			background: #222a3d;
			color: #aab2c4;
			cursor: not-allowed;
			box-shadow: none;
			opacity: 1;
		}
		button.admin-disabled-control:hover {
			box-shadow: none;
			transform: none;
		}
		.admin-link-button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 0.85rem 1.1rem;
			border-radius: var(--radius-pill);
			background: linear-gradient(135deg, var(--accent), var(--accent-2));
			color: var(--accent-text);
			font-weight: 800;
			text-decoration: none;
			box-shadow: 0 0 24px rgba(255, 177, 198, 0.22);
		}
		.admin-link-button--disabled {
			opacity: 0.45;
			cursor: not-allowed;
		}
		.admin-create-song {
			display: flex;
			justify-content: flex-end;
			margin: 1.5rem 0 0;
		}
		table {
			width: 100%;
			border-collapse: collapse;
			table-layout: fixed;
		}
		th,
		td {
			padding: 0.85rem 0.75rem;
			border-top: 1px solid var(--surface-border);
			text-align: left;
			vertical-align: top;
			overflow-wrap: anywhere;
		}
		th {
			color: var(--muted);
			font-family: var(--font-label);
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 0.05em;
			text-transform: uppercase;
		}
		th:nth-child(3),
		td:nth-child(3) {
			width: 6rem;
		}
		a { color: var(--accent); }
		.admin-alert {
			padding: 0.9rem 1rem;
			border: 1px solid var(--danger-border);
			border-radius: var(--radius-control);
			background: var(--danger-bg);
			color: var(--danger-text);
		}
		input,
		textarea {
			width: 100%;
			padding: 0.85rem 0.95rem;
			border: 1px solid var(--surface-border);
			border-radius: var(--radius-control);
			background: #060e20;
			color: var(--text);
			font: inherit;
		}
		textarea { min-height: 7rem; resize: vertical; }
		.admin-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			align-items: center;
			margin-top: 0.5rem;
		}
		.admin-danger-button {
			border: 1px solid var(--danger-border);
			background: var(--danger-bg);
			color: var(--danger-text);
			box-shadow: none;
		}
		@media (max-width: 640px) {
			body { display: block; padding: 1rem; }
			main { padding: 1.25rem; }
			.admin-logout-form { top: 1.25rem; right: 1.25rem; }
			table { min-width: 36rem; }
		}
	</style>
}

templ htmxScript() {
	<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.4/dist/htmx.min.js" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous"></script>
}

templ LoginCard(view loginView) {
	<section id="login-card" class="admin-card" aria-labelledby="admin-login-title">
		<div class="admin-card__header">
			<img class="admin-logo" src="/static/songdock_logo_dark.png" alt="SongDock"/>
			<p class="admin-eyebrow">Admin</p>
			<h1 id="admin-login-title">Log in</h1>
			<p class="admin-copy">Sign in to access admin pages.</p>
		</div>
		if view.Error != "" {
			<div class="admin-alert" role="alert">{ view.Error }</div>
		}
		<form
			class="admin-form"
			method="post"
			action="/admin/login"
			hx-post="/admin/login"
			hx-target="#login-card"
			hx-swap="outerHTML"
		>
			<label class="admin-label" for="email">Email</label>
			<input class="admin-input" id="email" name="email" type="email" autocomplete="email" required value={ view.Email }/>
			<label class="admin-label" for="password">Password</label>
			<input class="admin-input" id="password" name="password" type="password" autocomplete="current-password" required/>
			<button class="admin-button" type="submit">Log in</button>
		</form>
		<p class="admin-copy" style="margin-top:1rem;text-align:center;">
			New here? <a href="/admin/register" style="color:var(--accent);">Create your account</a>
		</p>
	</section>
}

templ LoginPage(view loginView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Admin Login</title>
			@htmxScript()
			@adminAuthStyles()
		</head>
		<body>
			@LoginCard(view)
		</body>
	</html>
}

templ RegisterCard(view registerView) {
	<section id="register-card" class="admin-card" aria-labelledby="admin-register-title">
		<div class="admin-card__header">
			<img class="admin-logo" src="/static/songdock_logo_dark.png" alt="SongDock"/>
			<p class="admin-eyebrow">Admin</p>
			<h1 id="admin-register-title">Create account</h1>
			<p class="admin-copy">Enter the invite code you received and choose a password.</p>
		</div>
		if view.Error != "" {
			<div class="admin-alert" role="alert">{ view.Error }</div>
		}
		<form
			class="admin-form"
			method="post"
			action="/admin/register"
			hx-post="/admin/register"
			hx-target="#register-card"
			hx-swap="outerHTML"
		>
			<label class="admin-label" for="invite_code">Invite code</label>
			<input class="admin-input" id="invite_code" name="invite_code" type="text" autocomplete="off" required value={ view.InviteCode }/>
			<label class="admin-label" for="password">Password</label>
			<input class="admin-input" id="password" name="password" type="password" autocomplete="new-password" minlength="12" required/>
			<label class="admin-label" for="password_confirm">Confirm password</label>
			<input class="admin-input" id="password_confirm" name="password_confirm" type="password" autocomplete="new-password" minlength="12" required/>
			<button class="admin-button" type="submit">Create account</button>
		</form>
		<p class="admin-copy" style="margin-top:1rem;text-align:center;">
			Already have an account? <a href="/admin/login" style="color:var(--accent);">Log in</a>
		</p>
	</section>
}

templ RegisterPage(view registerView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Create Account</title>
			@htmxScript()
			@adminAuthStyles()
		</head>
		<body>
			@RegisterCard(view)
		</body>
	</html>
}

templ HomePage(view homeView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Admin</title>
			@htmxScript()
			@adminBaseStyles()
		</head>
		<body>
			<main>
				<img class="admin-page-logo" src="/static/songdock_logo_dark.png" alt="SongDock"/>
				<h1>Admin</h1>
				<p>Signed in as { view.Email }.</p>
				<form class="admin-logout-form" method="post" action="/admin/logout">
					<button class="admin-logout-button" type="submit">Log out</button>
				</form>
				if view.Error != "" {
					<p class="admin-alert" role="alert">{ view.Error }</p>
				}
				if len(view.Artists) > 0 {
					<form method="post" action="/admin/active-artist" hx-post="/admin/active-artist" hx-trigger="change from:#artist_slug" hx-swap="none">
						<label for="artist_slug">Active artist</label>
						<select class="admin-disabled-control" id="artist_slug" name="artist_slug" required disabled>
							for _, artist := range view.Artists {
								if view.ActiveArtist != nil && view.ActiveArtist.Slug == artist.Slug {
									<option value={ artist.Slug } selected>{ artist.Name }</option>
								} else {
									<option value={ artist.Slug }>{ artist.Name }</option>
								}
							}
						</select>
						<button class="admin-disabled-control" type="submit" disabled>Update artist</button>
					</form>
				} else {
					<p>No artists are assigned to your account.</p>
				}
				if view.ActiveArtist != nil {
					<section aria-labelledby="songs-title">
						<h2 id="songs-title">Songs</h2>
						<table>
							<thead>
								<tr>
									<th scope="col">Title</th>
									<th scope="col">Final URL</th>
									<th scope="col">Actions</th>
								</tr>
							</thead>
							<tbody>
								if len(view.Songs) > 0 {
									for _, song := range view.Songs {
										<tr>
											<td>{ song.Title }</td>
											<td><a href={ song.FinalURL } target="_blank" rel="noopener noreferrer">{ song.FinalURL }</a></td>
											<td><a href={ song.EditURL }>Edit</a></td>
										</tr>
									}
								} else {
									<tr>
										<td colspan="3">No songs yet.</td>
									</tr>
								}
							</tbody>
						</table>
					</section>
					<p class="admin-create-song"><a class="admin-link-button" href="/admin/songs/new">Create a new song</a></p>
				} else {
					<p class="admin-create-song"><span class="admin-link-button admin-link-button--disabled" aria-disabled="true">Create a new song</span></p>
				}
			</main>
		</body>
	</html>
}

templ SongFormPage(view songFormView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ view.PageTitle }</title>
			@htmxScript()
			@adminBaseStyles()
		</head>
		<body>
			<main style="width:min(100%,36rem);">
				<img class="admin-page-logo" src="/static/songdock_logo_dark.png" alt="SongDock"/>
				<h1>{ view.PageTitle }</h1>
				if view.Error != "" {
					<p class="admin-alert" role="alert">{ view.Error }</p>
				}
				if view.ActiveArtist != nil {
					<p>Artist: { view.ActiveArtist.Name }</p>
					<form class="admin-form" method="post" action={ view.Action }>
						<label for="title">Title</label>
						<input id="title" name="title" required value={ view.Title }/>
						<label for="description">Description</label>
						<textarea id="description" name="description">{ view.Description }</textarea>
						<label for="image_url">Image URL</label>
						<input id="image_url" name="image_url" value={ view.ImageURL }/>
						<label for="youtube_url">YouTube URL</label>
						<input id="youtube_url" name="youtube_url" value={ view.YouTubeURL }/>
						<label for="spotify_url">Spotify URL</label>
						<input id="spotify_url" name="spotify_url" value={ view.SpotifyURL }/>
						<label for="apple_music_url">Apple Music URL</label>
						<input id="apple_music_url" name="apple_music_url" value={ view.AppleMusicURL }/>
						<div class="admin-actions">
							<button type="submit">{ view.SubmitLabel }</button>
							<a class="admin-link-button" href="/admin/">Cancel</a>
						</div>
					</form>
					if view.Mode == "edit" {
						<form method="post" action={ view.DeleteAction } hx-post={ view.DeleteAction } hx-confirm="Delete this song? This cannot be undone." hx-swap="none">
							<div class="admin-actions">
								<button class="admin-danger-button" type="submit">Delete Song</button>
							</div>
						</form>
					}
				} else {
					<p><a class="admin-link-button" href="/admin/">Back to dashboard</a></p>
				}
			</main>
		</body>
	</html>
}
