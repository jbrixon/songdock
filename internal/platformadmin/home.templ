package platformadmin

templ HomePage(view homeView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="icon" href="/static/favicon/favicon.ico"/>
			<title>Platform Admin</title>
			<link rel="stylesheet" href="/static/platformadmin.v1.css"/>
		</head>
		<body class="platform-home-body">
			<div class="platform-home">
				@platformAdminSidebar("dashboard")
				<main class="platform-home-main">
					<header class="platform-header platform-home-header">
						<div>
							<p class="platform-eyebrow">System Overview</p>
							<h1>Welcome, Admin</h1>
							<p class="platform-copy">Signed in as { view.Email }. Here is the current pulse of SongDock.</p>
						</div>
						<form class="platform-home-logout-form" method="post" action="/platform/admin/logout">
							<span class="platform-tooltip platform-home-logout-tooltip" data-tooltip="Log out">
								<button class="platform-home-logout" type="submit" aria-label="Log out" title="Log out"><svg class="platform-home-icon" aria-hidden="true"><use href="/static/lucide.svg#log-out"></use></svg></button>
							</span>
						</form>
					</header>
					<section class="platform-home-actions" aria-labelledby="platform-home-actions-title">
						<h2 id="platform-home-actions-title" class="platform-home-section-title">Quick Actions</h2>
						<div class="platform-home-action-grid">
							<a class="platform-home-action-card" href="/platform/admin/users">
								<span class="platform-home-action-icon"><svg class="platform-home-icon" aria-hidden="true"><use href="/static/lucide.svg#users"></use></svg></span>
								<h3>Manage Users</h3>
								<p>Review users, send invitations, and manage access.</p>
							</a>
							<a class="platform-home-action-card" href="/platform/admin/artists">
								<span class="platform-home-action-icon"><svg class="platform-home-icon" aria-hidden="true"><use href="/static/lucide.svg#music"></use></svg></span>
								<h3>Manage Artists</h3>
								<p>Create, manage, and delete artists.</p>
							</a>
						</div>
					</section>
				</main>
			</div>
		</body>
	</html>
}

