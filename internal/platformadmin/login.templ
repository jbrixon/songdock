package platformadmin

templ LoginCard(view loginView) {
	<section id="login-card" class="platform-card" aria-labelledby="platform-login-title">
		<div class="platform-card__header">
			<img class="platform-logo" src="/static/songdock_logo_dark.v2.png" alt="SongDock"/>
			<p class="platform-eyebrow">Platform Admin</p>
			<h1 id="platform-login-title">Log in</h1>
			<p class="platform-copy">Sign in to manage platform users.</p>
		</div>
		if view.Error != "" {
			<div class="platform-alert" role="alert">{ view.Error }</div>
		}
		<form
			class="platform-form"
			method="post"
			action="/platform/admin/login"
			hx-post="/platform/admin/login"
			hx-target="#login-card"
			hx-swap="outerHTML"
		>
			<label class="platform-label" for="username">Username</label>
			<input class="platform-input" id="username" name="username" type="text" autocomplete="username" required value={ view.Username }/>
			<label class="platform-label" for="password">Password</label>
			<input class="platform-input" id="password" name="password" type="password" autocomplete="current-password" required/>
			<button class="platform-button" type="submit">Log in</button>
		</form>
	</section>
}

templ LoginPage(view loginView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="icon" href="/static/favicon/favicon.ico"/>
			<title>Platform Admin Login</title>
			@htmxScript()
			<link rel="stylesheet" href="/static/platformadmin.v1.css"/>
		</head>
		<body>
			@LoginCard(view)
		</body>
	</html>
}

