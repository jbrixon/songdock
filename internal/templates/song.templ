package templates

templ SongPage(
	artistName string,
	songTitle string,
	description string,
	imageURL string,
	youtubeURL string,
	spotifyURL string,
	appleMusicURL string,
) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content={ description }/>
			<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex"/>
			<meta name="googlebot" content="noindex, nofollow"/>
			<meta name="AdsBot-Google" content="noindex"/>
			<meta name="CCBot" content="noindex"/>
			<meta name="GPTBot" content="noindex"/>
			<meta name="Claude-Web" content="noindex"/>
			<meta name="anthropic-ai" content="noindex"/>
			<meta name="PerplexityBot" content="noindex"/>
			<meta name="X-Robots-Tag" content="noindex, nofollow"/>
			<meta property="og:type" content="music.song"/>
			<meta property="og:title" content={ songTitle + " — " + artistName }/>
			<meta property="og:description" content={ description }/>
			<meta property="og:image" content={ imageURL }/>
			<meta property="twitter:card" content="summary_large_image"/>
			<meta property="twitter:title" content={ songTitle + " — " + artistName }/>
			<meta property="twitter:description" content={ description }/>
			<meta property="twitter:image" content={ imageURL }/>
			<link rel="icon" href="/static/favicon/favicon.ico" sizes="32x32"/>
			<link rel="icon" type="image/svg+xml" href="/static/favicon/favicon.svg"/>
			<link rel="icon" type="image/png" sizes="96x96" href="/static/favicon/favicon-96x96.png"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/static/favicon/apple-touch-icon.png"/>
			<link rel="manifest" href="/static/favicon/site.webmanifest"/>
			<title>{ songTitle } — { artistName }</title>
			<style>
				*, *::before, *::after {
				  box-sizing: border-box;
				  margin: 0;
				  padding: 0;
				}

				:root {
				  color-scheme: dark;
				  --color-bg: #0b1326;
				  --color-surface: rgba(23, 31, 51, 0.74);
				  --color-surface-strong: #222a3d;
				  --color-border: rgba(255, 255, 255, 0.1);
				  --color-text-primary: #dae2fd;
				  --color-text-secondary: #dfbec5;
				  --color-accent: #ffb1c6;
				  --color-accent-2: #ecc300;
				  --color-accent-glow: rgba(255, 177, 198, 0.28);
				  --color-spotify: #1DB954;
				  --color-apple: #fc3c44;
				  --color-youtube: #FF0000;
				  --font-display: Sora, ui-sans-serif, system-ui, sans-serif;
				  --font-sans: "Hanken Grotesk", Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
				  --font-label: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
				  --radius-artwork: 16px;
				  --radius-btn: 50px;
				  --transition: 0.22s cubic-bezier(0.4, 0, 0.2, 1);
				}

				html {
				  height: 100%;
				}

				body {
				  min-height: 100%;
				  background: var(--color-bg);
				  background-image:
				    radial-gradient(ellipse 80% 60% at 50% -10%, rgba(255, 177, 198, 0.2) 0%, transparent 70%),
				    radial-gradient(ellipse 46% 34% at 82% 82%, rgba(236, 195, 0, 0.12) 0%, transparent 64%);
				  color: var(--color-text-primary);
				  font-family: var(--font-sans);
				  display: flex;
				  align-items: center;
				  justify-content: center;
				  padding: clamp(1.5rem, 6vw, 3.5rem) 1rem;
				}

				main {
				  width: 100%;
				  max-width: 420px;
				  display: flex;
				  flex-direction: column;
				  align-items: center;
				  gap: 0;
				}

				.artwork-wrapper {
				  position: relative;
				  width: 100%;
				  aspect-ratio: 1 / 1;
				  border-radius: var(--radius-artwork);
				  overflow: hidden;
				  box-shadow:
				    0 0 0 1px var(--color-border),
				    0 24px 80px rgba(0, 0, 0, 0.58),
				    0 0 80px var(--color-accent-glow);
				}

				.artwork-wrapper::before {
				  content: "";
				  position: absolute;
				  inset: -1px;
				  z-index: 1;
				  pointer-events: none;
				  background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent 36%, rgba(255,255,255,0.04));
				  mix-blend-mode: screen;
				}

				.artwork-wrapper img {
				  width: 100%;
				  height: 100%;
				  object-fit: cover;
				  display: block;
				}

				.artwork-placeholder {
				  width: 100%;
				  height: 100%;
				  background: linear-gradient(135deg, #131b2e 0%, #2d3449 54%, #793104 100%);
				  display: flex;
				  align-items: center;
				  justify-content: center;
				}

				.artwork-placeholder svg {
				  opacity: 0.18;
				}

				.text-block {
				  margin-top: clamp(1.5rem, 5vw, 2.25rem);
				  text-align: center;
				  width: 100%;
				}

				.band-name {
				  font-size: clamp(0.75rem, 2.5vw, 0.85rem);
				  font-weight: 600;
				  letter-spacing: 0.18em;
				  text-transform: uppercase;
				  color: var(--color-accent-2);
				  font-family: var(--font-label);
				  margin-bottom: 0.45rem;
				}

				.song-title {
				  font-size: clamp(1.8rem, 7vw, 2.6rem);
				  font-family: var(--font-display);
				  font-weight: 800;
				  letter-spacing: 0;
				  line-height: 1.08;
				  text-wrap: balance;
				  color: var(--color-text-primary);
				}

				.links {
				  margin-top: clamp(1.75rem, 5vw, 2.5rem);
				  width: 100%;
				  display: flex;
				  flex-direction: column;
				  gap: 0.75rem;
				  list-style: none;
				}

				.powered-by {
				  display: flex;
				  align-items: baseline;
				  justify-content: center;
				  gap: 0.35rem;
				  margin-top: 2.75rem;
				  color: rgba(218, 226, 253, 0.58);
				  font-size: 0.78rem;
				  letter-spacing: 0.02em;
				}

				.songdock-logo {
				  display: inline-flex;
				  align-items: baseline;
				  color: inherit;
				  font-family: Inter, Manrope, "Helvetica Neue", Arial, sans-serif;
				  font-size: 1rem;
				  font-weight: 700;
				  line-height: 1;
				  letter-spacing: -0.055em;
				  text-decoration: none;
				  white-space: nowrap;
				}

				.songdock-logo__song { color: #fff; }

				.songdock-logo__dock {
				  color: #ff6b68;
				  background: linear-gradient(90deg, #f43f72 0%, #ff6467 45%, #ff9b3f 100%);
				  background-clip: text;
				  -webkit-background-clip: text;
				  -webkit-text-fill-color: transparent;
				}

				.links li {
				  width: 100%;
				}

				.streaming-link {
				  display: flex;
				  align-items: center;
				  justify-content: center;
				  gap: 0.65rem;
				  width: 100%;
				  min-height: 3.25rem;
				  padding: 0.85rem 1.5rem;
				  border-radius: var(--radius-btn);
				  border: 1px solid var(--color-border);
				  background: var(--color-surface);
				  color: var(--color-text-primary);
				  font-family: var(--font-sans);
				  font-size: 0.95rem;
				  font-weight: 700;
				  letter-spacing: 0.02em;
				  text-decoration: none;
				  cursor: pointer;
				  backdrop-filter: blur(18px);
				  transition: background var(--transition), border-color var(--transition), transform var(--transition), box-shadow var(--transition);
				  -webkit-tap-highlight-color: transparent;
				}

				.streaming-link:focus-visible {
				  outline: 2px solid var(--color-accent);
				  outline-offset: 3px;
				}

				.streaming-link svg {
				  flex-shrink: 0;
				}

				.link--spotify:hover,
				.link--spotify:focus-visible {
				  background: rgba(29, 185, 84, 0.12);
				  border-color: rgba(29, 185, 84, 0.5);
				  box-shadow: 0 0 20px rgba(29, 185, 84, 0.15);
				  transform: translateY(-1px);
				}

				.link--apple:hover,
				.link--apple:focus-visible {
				  background: rgba(252, 60, 68, 0.12);
				  border-color: rgba(252, 60, 68, 0.5);
				  box-shadow: 0 0 20px rgba(252, 60, 68, 0.15);
				  transform: translateY(-1px);
				}

				.link--youtube:hover,
				.link--youtube:focus-visible {
				  background: rgba(255, 0, 0, 0.1);
				  border-color: rgba(255, 0, 0, 0.45);
				  box-shadow: 0 0 20px rgba(255, 0, 0, 0.12);
				  transform: translateY(-1px);
				}

				.streaming-link:active {
				  transform: translateY(0);
				  box-shadow: none;
				}

				.link-icon {
				  width: 22px;
				  height: 22px;
				}

				@media (min-width: 520px) {
				  main {
				    max-width: 460px;
				  }
				}

				@media (prefers-reduced-motion: reduce) {
				  .streaming-link {
				    transition: none;
				  }
				}

				.visually-hidden {
				  position: absolute;
				  width: 1px;
				  height: 1px;
				  padding: 0;
				  margin: -1px;
				  overflow: hidden;
				  clip: rect(0, 0, 0, 0);
				  white-space: nowrap;
				  border: 0;
				}
			</style>
		</head>
		<body>
			<main>
				<figure class="artwork-wrapper">
					if imageURL != "" {
						<img src={ imageURL } alt={ "Song artwork for " + songTitle + " by " + artistName }/>
					} else {
						<div class="artwork-placeholder" aria-hidden="true">
							<svg width="96" height="96" viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path d="M48 8C26.91 8 10 24.91 10 46s16.91 38 38 38 38-16.91 38-38S69.09 8 48 8zm0 68C30.33 76 16 61.67 16 44s14.33-32 32-32 32 14.33 32 32S65.67 76 48 76zm0-52a20 20 0 1 0 0 40 20 20 0 0 0 0-40zm0 32a12 12 0 1 1 0-24 12 12 0 0 1 0 24zm0-16a4 4 0 1 0 0 8 4 4 0 0 0 0-8z" fill="white"></path>
							</svg>
						</div>
					}
					<figcaption class="visually-hidden">Song artwork for { songTitle } by { artistName }</figcaption>
				</figure>
				<div class="text-block">
					<p class="band-name">{ artistName }</p>
					<h1 class="song-title">{ songTitle }</h1>
				</div>
				<ul class="links" aria-label="Listen on streaming platforms">
					if spotifyURL != "" {
						<li>
							<a
								href={ spotifyURL }
								class="streaming-link link--spotify"
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Listen on Spotify"
							>
								<svg class="link-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
									<path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm4.586 14.424a.623.623 0 0 1-.857.207c-2.348-1.435-5.304-1.76-8.785-.964a.623.623 0 0 1-.277-1.215c3.808-.87 7.076-.496 9.712 1.115a.623.623 0 0 1 .207.857zm1.223-2.722a.78.78 0 0 1-1.072.257c-2.687-1.652-6.785-2.131-9.965-1.166a.78.78 0 0 1-.973-.519.781.781 0 0 1 .519-.973c3.632-1.102 8.147-.568 11.234 1.329a.78.78 0 0 1 .257 1.072zm.105-2.835C14.692 8.95 9.375 8.775 6.297 9.71a.937.937 0 1 1-.543-1.793c3.532-1.072 9.404-.866 13.115 1.337a.937.937 0 0 1-.955 1.613z" fill="#1DB954"></path>
								</svg>
								Listen on Spotify
							</a>
						</li>
					}
					if appleMusicURL != "" {
						<li>
							<a
								href={ appleMusicURL }
								class="streaming-link link--apple"
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Listen on Apple Music"
							>
								<svg class="link-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
									<path d="M23.994 6.124a9.23 9.23 0 0 0-.24-2.19c-.317-1.31-1.062-2.31-2.18-3.043a5.022 5.022 0 0 0-1.877-.726 10.496 10.496 0 0 0-1.564-.15c-.04-.003-.083-.01-.124-.013H5.986c-.152.01-.303.017-.455.026C4.786.07 4.043.15 3.34.428 2.004.958 1.04 1.88.475 3.208c-.192.448-.292.925-.363 1.408-.056.392-.08.785-.09 1.18 0 .032-.007.062-.01.093v12.223c.01.14.017.283.027.424.05.815.154 1.624.497 2.373.65 1.42 1.738 2.353 3.234 2.802.42.127.856.187 1.293.22.555.044 1.11.05 1.667.053h11.03c.525 0 1.048-.026 1.57-.1.823-.106 1.597-.35 2.296-.81 1.268-.836 1.994-2.013 2.253-3.485.085-.476.112-.963.115-1.453.003-.505 0-1.01 0-1.515V6.124zM14.57 14.8h-1.09v-1.088c-.37.372-.8.648-1.283.844-.717.293-1.452.338-2.195.14-1.19-.32-2.001-1.058-2.424-2.22-.275-.757-.29-1.534-.098-2.316.28-1.133 1.004-1.863 2.113-2.22.715-.23 1.443-.23 2.166-.038.357.096.687.247.98.468.01.008.022.014.043.026V6.5h1.79v8.3zm5.055-3.527c0 .95-.28 1.79-.895 2.5-.675.77-1.537 1.18-2.55 1.27-.543.05-1.07-.01-1.58-.21-.67-.26-1.2-.7-1.56-1.34-.23-.41-.36-.86-.41-1.34-.08-.85.1-1.63.55-2.34.49-.77 1.17-1.25 2.07-1.44.61-.13 1.2-.07 1.78.14.72.26 1.26.73 1.62 1.41.27.51.39 1.06.39 1.63l-.42-.28z" fill="#fc3c44"></path>
								</svg>
								Listen on Apple Music
							</a>
						</li>
					}
					if youtubeURL != "" {
						<li>
							<a
								href={ youtubeURL }
								class="streaming-link link--youtube"
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Watch on YouTube"
							>
								<svg class="link-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
									<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" fill="#FF0000"></path>
								</svg>
								Watch on YouTube
							</a>
						</li>
					}
				</ul>
				<footer class="powered-by">
					<span>Powered by</span>
					<a class="songdock-logo" href="https://github.com/jbrixon/songdock" target="_blank" rel="noopener noreferrer" aria-label="SongDock on GitHub"><span class="songdock-logo__song">Song</span><span class="songdock-logo__dock">Dock</span></a>
				</footer>
			</main>
		</body>
	</html>
}
